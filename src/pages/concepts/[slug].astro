---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getConcepts } from '../../projects';
import { url } from '../../url';

export async function getStaticPaths() {
  const projects = await getConcepts();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, location, year, summary, cover, coverAlt, coverCaption, images, services } = project.data;
// Group images by room, keeping the order they were listed in.
const groups: { name?: string; items: typeof images }[] = [];
for (const img of images) {
  const last = groups[groups.length - 1];
  if (last && last.name === img.group) last.items.push(img);
  else groups.push({ name: img.group, items: [img] });
}
const { Content } = await render(project);
---
<Base title={title} description={summary ?? `${title}, a concept design by DeClaire Design.`}>
  <article class="section container">
    <p class="eyebrow">{['Concept Design', location, year].filter(Boolean).join(' · ')}</p>
    <h1>{title}</h1>
    <figure class="cover-figure">
      <Image class="cover" src={cover} alt={coverAlt} widths={[800, 1600, 2400]} sizes="100vw" loading="eager" />
      {coverCaption && <figcaption>{coverCaption}</figcaption>}
    </figure>
    <div class="story">
      <Content />
      {services.length > 0 && (
        <ul class="services">{services.map((s) => <li>{s}</li>)}</ul>
      )}
    </div>
    {groups.map((group) => (
      <section class="room">
        {group.name && <h2>{group.name}</h2>}
        <div class="gallery">
          {group.items.map((img) => (
            <figure>
              <Image src={img.src} alt={img.alt} widths={[600, 1200, 1800]} sizes="(max-width: 700px) 100vw, 50vw" />
              {img.caption && <figcaption>{img.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    ))}
    <p><a href={url('/concepts')}>Back to all concept designs</a></p>
  </article>
</Base>

<style>
  .cover-figure { margin: var(--space-3) 0 var(--space-4); }
  .cover { width: 100%; }
  figcaption { font-size: var(--text-sm); color: var(--color-muted); margin-top: var(--space-1); }
  .room { margin-bottom: var(--space-4); }
  .room h2 { margin-bottom: var(--space-2); }
  figure { margin: 0; }
  .story { margin-bottom: var(--space-4); }
  .services { display: flex; flex-wrap: wrap; gap: var(--space-1); list-style: none; padding: 0; }
  .services li { font-size: var(--text-sm); border: 1px solid var(--color-border); padding: 0.2rem 0.6rem; }
  .gallery { display: grid; gap: var(--space-2); grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); }
  .gallery :global(img) { width: 100%; height: auto; }
</style>
