---
import Base from '../layouts/Base.astro';
import Carousel from '../components/Carousel.astro';
import settings from '../settings.json';
import { getProjects } from '../projects';
import { url } from '../url';

// Every photo from every published project, alternating between projects.
const projects = await getProjects();
const perProject = projects.map((p) => [
  { src: p.data.cover, alt: p.data.coverAlt },
  ...p.data.images.map((img) => ({ src: img.src, alt: img.alt })),
].map((photo) => ({ ...photo, href: url(`/work/${p.id}`), title: p.data.title })));
const slides = Array.from({ length: Math.max(0, ...perProject.map((l) => l.length)) }, (_, i) =>
  perProject.flatMap((l) => (l[i] ? [l[i]] : [])),
).flat();
---
<Base>
  <section class="home container">
    <h1 class="visually-hidden">{settings.name}: interior design in the Bay Area</h1>
    <Carousel slides={slides} label="Photos from our projects" />
  </section>
</Base>

<style>
  .home { padding-block: var(--space-4) var(--space-5); }
</style>
