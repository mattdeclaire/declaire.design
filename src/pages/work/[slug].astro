---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../projects';
import { url } from '../../url';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, location, year, summary, cover, coverAlt, images, beforeAfter, services } = project.data;
const { Content } = await render(project);
---
<Base title={title} description={summary ?? `${title}, an interior design project by Katie DeClaire.`}>
  <article class="section container">
    <p class="eyebrow">{[location, year].filter(Boolean).join(' · ')}</p>
    <h1>{title}</h1>
    <Image class="cover" src={cover} alt={coverAlt} widths={[800, 1600, 2400]} sizes="100vw" loading="eager" />
    <div class="story">
      <Content />
      {services.length > 0 && (
        <ul class="services">{services.map((s) => <li>{s}</li>)}</ul>
      )}
    </div>
    {images.length > 0 && (
      <div class="gallery">
        {images.map((img) => (
          <Image src={img.src} alt={img.alt} widths={[600, 1200, 1800]} sizes="(max-width: 700px) 100vw, 50vw" />
        ))}
      </div>
    )}
    {beforeAfter.length > 0 && (
      <section class="before-after" aria-labelledby="before-after-title">
        <h2 id="before-after-title">Before and after</h2>
        {beforeAfter.map((pair) => (
          <div class="pair">
            <h3>{pair.room}</h3>
            <div class="pair-images">
              <figure>
                <Image src={pair.before} alt={pair.beforeAlt} widths={[600, 1080]} sizes="(max-width: 700px) 100vw, 50vw" />
                <figcaption>Before</figcaption>
              </figure>
              <figure>
                <Image src={pair.after} alt={pair.afterAlt} widths={[600, 1200, 1800]} sizes="(max-width: 700px) 100vw, 50vw" />
                <figcaption>After</figcaption>
              </figure>
            </div>
          </div>
        ))}
      </section>
    )}
    <p><a href={url('/work')}>Back to all projects</a></p>
  </article>
</Base>

<style>
  .cover { width: 100%; margin-block: var(--space-3) var(--space-4); }
  .story { margin-bottom: var(--space-4); }
  .services { display: flex; flex-wrap: wrap; gap: var(--space-1); list-style: none; padding: 0; }
  .services li { font-size: var(--text-sm); border: 1px solid var(--color-border); padding: 0.2rem 0.6rem; }
  .gallery { display: grid; gap: var(--space-2); grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); margin-bottom: var(--space-4); }
  .gallery :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .before-after { margin-bottom: var(--space-4); }
  .before-after h2 { margin-bottom: var(--space-3); }
  .pair { margin-bottom: var(--space-4); }
  .pair h3 { margin-bottom: var(--space-1); }
  .pair-images { display: grid; gap: var(--space-2); grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .pair-images figure { margin: 0; }
  .pair-images :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .pair-images figcaption { font-size: var(--text-sm); color: var(--color-muted); margin-top: var(--space-1); }
</style>
