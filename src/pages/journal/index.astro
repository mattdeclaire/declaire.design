---
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../projects';
import { url } from '../../url';

const posts = await getPosts();
const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Journal" description="Interior design notes and tips from DeClaire Design.">
  <section class="section container">
    <h1>Journal</h1>
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <p class="date"><time datetime={post.data.date.toISOString().slice(0, 10)}>{fmt.format(post.data.date)}</time></p>
          <h2><a href={url(`/journal/${post.id}`)}>{post.data.title}</a></h2>
          <p>{post.data.summary}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .posts { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: grid; gap: var(--space-4); max-width: var(--text-width); }
  .posts li { border-top: 1px solid var(--color-border); padding-top: var(--space-3); }
  .posts h2 { margin: 0 0 var(--space-1); }
  .posts h2 a { color: var(--color-body); text-decoration: none; }
  .posts h2 a:hover, .posts h2 a:focus-visible { color: var(--color-accent); }
  .date { font-size: var(--text-sm); color: var(--color-muted); letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 var(--space-1); }
</style>
