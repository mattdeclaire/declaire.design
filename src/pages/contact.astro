---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import settings from '../settings.json';
import deskPhoto from '../assets/katie-desk.jpg';

const entry = await getEntry('pages', 'contact');
if (!entry) throw new Error('Missing src/content/pages/contact.md');
const { Content } = await render(entry);

const mailto = `mailto:${settings.email}?subject=${encodeURIComponent('Consultation inquiry')}`;
---
<Base title={entry.data.title} description={entry.data.description}>
  <section class="section container contact">
    <div class="details">
      <h1>{entry.data.heading ?? entry.data.title}</h1>
      <div class="prose"><Content /></div>
      <p class="eyebrow">General inquiries</p>
      <p><a href={`mailto:${settings.email}`}>{settings.email}</a></p>
      <p><a class="button" href={mailto}>Book a consultation</a></p>
      <ul class="social" aria-label="Social media">
        {/* TODO(Katie): add a Facebook link once she sends the page address. */}
        <li><a href={settings.instagram} rel="noopener">Instagram</a></li>
      </ul>
    </div>
    <figure class="photo">
      <Image src={deskPhoto} alt="Katie DeClaire at her desk, looking over fabric and finish samples" widths={[600, 1000, 1400]} sizes="(max-width: 800px) 100vw, 55vw" />
    </figure>
  </section>
</Base>

<style>
  .contact { display: grid; gap: var(--space-4); align-items: center; }
  @media (min-width: 800px) {
    .contact { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: var(--space-5); }
  }
  .details { min-width: 0; }
  .details .eyebrow { margin-top: var(--space-3); margin-bottom: 0; }
  .social { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: flex; gap: var(--space-3); }
  .photo { margin: 0; min-width: 0; }
</style>
