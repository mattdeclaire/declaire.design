---
import '../styles/global.css';
import settings from '../settings.json';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import monogram from '../assets/monogram.png';
import { getCollection } from 'astro:content';
import { url } from '../url';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = settings.description } = Astro.props;

// The Concept Designs tab only appears once at least one concept is published.
const concepts = await getCollection('concepts', ({ data }) => !data.draft);
const navItems = settings.nav.filter((item) => item.href !== '/concepts' || concepts.length > 0);
const fullTitle = title ? `${title} | ${settings.name}` : `${settings.name} | Interior design in the Bay Area`;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-96x96.png')} type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/site.webmanifest')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Inter:wght@400;500;600&display=swap" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href={url('/')}>
          <Image class="logo-mark" src={monogram} alt="DD monogram" aria-hidden="true" widths={[144, 288]} sizes="(max-width: 700px) 3.5rem, 4.5rem" loading="eager" />
          <Image class="wordmark" src={logo} alt={`${settings.name}, home`} widths={[176, 352]} sizes="(max-width: 700px) 8.5rem, 11rem" loading="eager" />
        </a>
        <nav aria-label="Main">
          <ul>
            {navItems.map((item) => (
              <li>
                <a class:list={[{ cta: item.href === '/contact' }]} href={url(item.href)} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <Image class="monogram" src={monogram} alt={`${settings.name} monogram`} widths={[160, 320]} sizes="(max-width: 700px) 4rem, 5rem" />
        <div class="footer-text">
          {/* TODO(Katie): add a Facebook link here once she sends the page address. */}
          <ul class="social" aria-label="Social media">
            <li><a href={settings.instagram} rel="noopener">Instagram</a></li>
          </ul>
          <p><a href={`mailto:${settings.email}`}>{settings.email}</a></p>
          <p class="copyright">© {new Date().getFullYear()} {settings.name}. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--color-border); }
  .header-inner {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: var(--space-1); padding-block: var(--space-2);
  }
  .logo { display: flex; align-items: center; gap: var(--space-2); }
  .logo :global(img) { height: auto; flex: none; }
  .logo :global(.logo-mark) { width: var(--size-logo-mark); }
  .logo :global(.wordmark) { width: var(--size-logo); }
  @media (max-width: 700px) {
    .logo :global(.logo-mark) { width: var(--size-logo-mark-mobile); }
    .logo :global(.wordmark) { width: var(--size-logo-mobile); }
    .monogram { width: var(--size-monogram-mobile); }
  }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-1) var(--space-3); }
  nav a { color: var(--color-body); text-decoration: none; font-size: var(--text-sm); letter-spacing: 0.08em; text-transform: uppercase; }
  nav a:hover, nav a:focus-visible { color: var(--color-accent); }
  /* The current page is underlined; Contact is always the accent color. */
  nav a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.5em; }
  nav a.cta { color: var(--color-accent); }
  .site-footer { border-top: 1px solid var(--color-border); margin-top: var(--space-section); }
  .footer-inner { padding-block: var(--space-4); display: flex; align-items: center; gap: var(--space-3); }
  .footer-text { display: grid; gap: var(--space-1); min-width: 0; }
  .monogram { width: var(--size-monogram); height: auto; flex: none; }
  .footer-text p { margin: 0; }
  .social { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--space-3); }
  .copyright { font-size: var(--text-sm); color: var(--color-muted); }
</style>
