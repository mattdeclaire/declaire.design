---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Slide { src: ImageMetadata; alt: string; href: string; title: string }
interface Props { slides: Slide[]; label: string }
const { slides, label } = Astro.props;
---
<section class="carousel" aria-roledescription="carousel" aria-label={label}>
  <ul class="track" data-track>
    {slides.map((slide, i) => (
      <li class="slide" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`}>
        <a href={slide.href}>
          <Image
            src={slide.src}
            alt={slide.alt}
            widths={[800, 1200, 1600]}
            sizes="(max-width: 700px) 100vw, 80vw"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
          <span class="caption">{slide.title}</span>
        </a>
      </li>
    ))}
  </ul>
  <div class="controls" data-controls hidden>
    <button type="button" data-prev aria-label="Previous photo">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 4 7 12l8 8" fill="none" stroke="currentColor" stroke-width="2" /></svg>
    </button>
    <button type="button" data-next aria-label="Next photo">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m9 4 8 8-8 8" fill="none" stroke="currentColor" stroke-width="2" /></svg>
    </button>
  </div>
</section>

<script>
  // Buttons only appear when JavaScript runs; without it the photos still scroll and every link works.
  for (const carousel of document.querySelectorAll<HTMLElement>('.carousel')) {
    const track = carousel.querySelector<HTMLElement>('[data-track]');
    const controls = carousel.querySelector<HTMLElement>('[data-controls]');
    if (!track || !controls) continue;
    controls.hidden = false;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const go = (dir: number) =>
      track.scrollBy({ left: dir * track.clientWidth * 0.8, behavior: reduce.matches ? 'auto' : 'smooth' });
    carousel.querySelector('[data-prev]')?.addEventListener('click', () => go(-1));
    carousel.querySelector('[data-next]')?.addEventListener('click', () => go(1));
  }
</script>

<style>
  .carousel { position: relative; }
  .track {
    list-style: none; margin: 0; padding: 0;
    display: flex; gap: var(--space-2);
    overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar { display: none; }
  .slide { flex: 0 0 88%; scroll-snap-align: center; }
  @media (min-width: 700px) { .slide { flex-basis: 80%; } }
  .slide a { display: block; color: inherit; text-decoration: none; }
  .slide :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .caption { display: block; margin-top: var(--space-1); font-size: var(--text-sm); color: var(--color-muted); }
  .slide a:hover .caption, .slide a:focus-visible .caption { color: var(--color-accent); }
  .controls { display: flex; gap: var(--space-1); justify-content: flex-end; margin-top: var(--space-2); }
  .controls[hidden] { display: none; }
  button {
    width: var(--size-carousel-button); height: var(--size-carousel-button);
    display: grid; place-items: center; cursor: pointer;
    border: 1px solid var(--color-heading); background: var(--color-canvas); color: var(--color-heading);
    border-radius: var(--radius);
  }
  button:hover { background: var(--color-heading); color: var(--color-canvas); }
</style>
